// Purpose: Sample the device clock into one 64-bit word.
// Owns: Nothing.
// Launch shape: One thread.
// Lifetime: One launch.
.version 8.0
.target sm_86
.address_size 64

.visible .entry aotx_clock_sample(.param .u64 out)
{
    .reg .b64 %rd<4>;
    ld.param.u64 %rd1, [out];
    cvta.to.global.u64 %rd2, %rd1;
    mov.u64 %rd3, %globaltimer;
    st.global.u64 [%rd2], %rd3;
    ret;
}
